---
/**
 * Картинка или встроенная SVG-сцена в одном контейнере.
 * Источник — ILLUSTRATIONS в src/data/site.ts. Пока там `null`, рендерится слот (SVG).
 */
interface Props {
  src: string | null;
  alt: string;
  class?: string;
  /** Первый экран: грузим сразу и с приоритетом. Остальное — lazy. */
  eager?: boolean;
  width?: number;
  height?: number;
  sizes?: string;
}

const {
  src,
  alt,
  class: className,
  eager = false,
  width = 1200,
  height = 1200,
  sizes = "(max-width: 900px) 92vw, 46vw",
} = Astro.props;
---

<div class={className}>
  {
    src ? (
      <img
        src={src}
        alt={alt}
        width={width}
        height={height}
        sizes={sizes}
        loading={eager ? "eager" : "lazy"}
        fetchpriority={eager ? "high" : "auto"}
        decoding="async"
      />
    ) : (
      <slot />
    )
  }
</div>
