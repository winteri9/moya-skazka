---
/**
 * Главная иллюстрация: мама с мальчиком в волшебном лесу.
 * Нарисована вручную в акварельной палитре проекта — без сетевых запросов.
 */
---

<svg
  viewBox="0 0 720 820"
  preserveAspectRatio="xMidYMid slice"
  role="img"
  aria-label="Мама и маленький мальчик гуляют по волшебному лесу: вокруг светлячки, лисёнок и зайчонок"
>
  <defs>
    <linearGradient id="fsSky" x1="0.1" y1="0" x2="0.2" y2="1">
      <stop offset="0" stop-color="#f9efdd" />
      <stop offset="0.38" stop-color="#f4e4c9" />
      <stop offset="0.7" stop-color="#eed9b9" />
      <stop offset="1" stop-color="#e5cea8" />
    </linearGradient>
    <radialGradient id="fsSun" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#fff8e2" stop-opacity="0.92" />
      <stop offset="0.46" stop-color="#fdefcd" stop-opacity="0.44" />
      <stop offset="1" stop-color="#fdefcd" stop-opacity="0" />
    </radialGradient>
    <linearGradient id="fsGround" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#dbc8a2" />
      <stop offset="0.5" stop-color="#cfb78d" />
      <stop offset="1" stop-color="#bda176" />
    </linearGradient>
    <linearGradient id="fsDress" x1="0" y1="0" x2="0.35" y2="1">
      <stop offset="0" stop-color="#cfa794" />
      <stop offset="1" stop-color="#a97a68" />
    </linearGradient>
    <linearGradient id="fsTrunk" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#c0a686" />
      <stop offset="0.6" stop-color="#b39a7a" />
      <stop offset="1" stop-color="#9c8062" />
    </linearGradient>
    <linearGradient id="fsVignette" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#8b7a63" stop-opacity="0.14" />
      <stop offset="0.28" stop-color="#8b7a63" stop-opacity="0" />
      <stop offset="1" stop-color="#8b7a63" stop-opacity="0.1" />
    </linearGradient>
    <radialGradient id="fsGlow" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#fff6cf" stop-opacity="0.95" />
      <stop offset="1" stop-color="#ffeaa4" stop-opacity="0" />
    </radialGradient>
    <filter id="fsFar"><feGaussianBlur stdDeviation="6" /></filter>
    <filter id="fsMid"><feGaussianBlur stdDeviation="2.4" /></filter>
    <filter id="fsSoft"><feGaussianBlur stdDeviation="0.6" /></filter>
    <filter id="fsShaft"><feGaussianBlur stdDeviation="16" /></filter>
    <filter id="fsGrain" x="0" y="0" width="100%" height="100%">
      <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="4" stitchTiles="stitch" />
      <feColorMatrix type="saturate" values="0" />
    </filter>
  </defs>

  <rect width="720" height="820" fill="url(#fsSky)" />
  <circle cx="232" cy="196" r="286" fill="url(#fsSun)" />
  <circle cx="232" cy="196" r="44" fill="#fffaea" opacity="0.4" filter="url(#fsFar)" />

  <!-- световые шахты -->
