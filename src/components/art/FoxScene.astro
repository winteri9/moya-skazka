---
/**
 * Иллюстрация к примеру сказки: Миша и лисёнок.
 * Та же акварельная палитра и приёмы, что и в главной сцене.
 */
---

<svg
  viewBox="0 0 560 560"
  preserveAspectRatio="xMidYMid slice"
  role="img"
  aria-label="Мальчик Миша встретил в лесу маленького лисёнка"
>
  <defs>
    <linearGradient id="fxSky" x1="0.1" y1="0" x2="0.2" y2="1">
      <stop offset="0" stop-color="#f9efdd" />
      <stop offset="0.45" stop-color="#f3e2c6" />
      <stop offset="1" stop-color="#e7d1ab" />
    </linearGradient>
    <linearGradient id="fxGround" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#d9c6a0" />
      <stop offset="1" stop-color="#bda176" />
    </linearGradient>
    <linearGradient id="fxTrunk" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#c0a686" />
      <stop offset="1" stop-color="#9c8062" />
    </linearGradient>
    <radialGradient id="fxSun" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#fff8e2" stop-opacity="0.9" />
      <stop offset="0.5" stop-color="#fdefcd" stop-opacity="0.4" />
      <stop offset="1" stop-color="#fdefcd" stop-opacity="0" />
    </radialGradient>
    <radialGradient id="fxGlow" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#fff6cf" stop-opacity="0.95" />
      <stop offset="1" stop-color="#ffeaa4" stop-opacity="0" />
    </radialGradient>
    <linearGradient id="fxVignette" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#8b7a63" stop-opacity="0.12" />
      <stop offset="0.3" stop-color="#8b7a63" stop-opacity="0" />
      <stop offset="1" stop-color="#8b7a63" stop-opacity="0.1" />
    </linearGradient>
    <filter id="fxFar"><feGaussianBlur stdDeviation="5" /></filter>
    <filter id="fxMid"><feGaussianBlur stdDeviation="2" /></filter>
    <filter id="fxSoft"><feGaussianBlur stdDeviation="0.5" /></filter>
    <filter id="fxGrain" x="0" y="0" width="100%" height="100%">
      <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="4" stitchTiles="stitch" />
      <feColorMatrix type="saturate" values="0" />
    </filter>
  </defs>

  <rect width="560" height="560" fill="url(#fxSky)" />
  <circle cx="150" cy="150" r="205" fill="url(#fxSun)" />

  <!-- дальняя кромка -->
  <g filter="url(#fxFar)">
    <path
      d="M-20 250c48-30 84-38 128-32 46 6 66 28 112 26 46-2 68-30 118-30 48 0 76 26 122 22 30-3 58-6 80-4v348H-20Z"
      fill="#cbd6bb"
      opacity="0.75"
    />
    <path d="M-20 322c56-22 100-28 154-20 50 8 74 24 126 20 52-4 74-24 128-22 54 2 82 20 132 16v264H-20Z" fill="#c0cfb1" opacity="0.7" />
  </g>

  <!-- кроны -->
  <g filter="url(#fxMid)">
    <g fill="#a9bc9d">
      <ellipse cx="46" cy="92" rx="104" ry="88" />
      <ellipse cx="514" cy="78" rx="108" ry="92" />
    </g>
    <g fill="#93a888">
      <ellipse cx="-4" cy="152" rx="62" ry="56" />
      <ellipse cx="562" cy="146" rx="66" ry="58" />
      <ellipse cx="286" cy="-10" rx="96" ry="52" opacity="0.6" />
    </g>
  </g>

  <!-- стволы -->
  <g fill="url(#fxTrunk)">
    <rect x="22" y="120" width="24" height="350" rx="12" />
    <rect x="504" y="104" width="26" height="366" rx="13" />
  </g>
  <g stroke="#a98d6d" stroke-linecap="round" fill="none" opacity="0.75">
    <path d="M40 210c16-8 26-2 36 6" stroke-width="5" />
    <path d="M520 236c-16-6-26 0-34 8" stroke-width="5.5" />
  </g>

  <!-- земля -->
  <path d="M0 420c70-14 118 6 186-2 62-8 92-14 146-10 62 4 100 12 162 6 24-2 44-4 66-2v148H0Z" fill="url(#fxGround)" />
  <path d="M0 474c74-10 132 6 206-2 64-7 98 8 160 4 66-4 118 4 194-2v86H0Z" fill="#c9b087" opacity="0.8" />
  <path d="M0 520c94-10 164 6 250-2 74-7 130 6 200 2 46-3 80-2 110 0v40H0Z" fill="#bda176" />

  <!-- куст и трава -->
  <g fill="#9db38f">
    <path d="M330 436c8-22 28-32 46-28 15 4 23 13 25 26-20 9-52 9-71 2Z" />
    <path d="M118 442c7-20 25-29 41-25 14 3 21 12 23 24-18 8-46 8-64 1Z" opacity="0.9" />
  </g>
  <g stroke="#7f9474" stroke-width="3" stroke-linecap="round" fill="none">
    <path d="M84 462c3-16 8-27 14-36" />
    <path d="M100 466c2-14 6-25 11-34" />
    <path d="M452 460c3-16 9-27 15-36" />
    <path d="M470 464c2-14 7-25 12-34" />
    <path d="M244 486c3-16 7-27 13-36" />
    <path d="M262 490c2-14 6-25 11-34" />
    <path d="M366 484c3-16 8-27 14-36" />
  </g>
  <g fill="#fdf6e6">
    <circle cx="132" cy="486" r="3" />
    <circle cx="416" cy="492" r="2.8" />
    <circle cx="196" cy="472" r="2.4" />
  </g>
  <g fill="#dfae9b">
    <circle cx="132" cy="486" r="1.2" />
    <circle cx="416" cy="492" r="1.1" />
  </g>

  <!-- грибы -->
  <g>
    <path d="M104 496v12" stroke="#e6d6bb" stroke-width="4.4" stroke-linecap="round" />
    <path d="M90 497c0-12 7-20 15-20s15 8 15 20Z" fill="#c08e79" />
    <circle cx="100" cy="488" r="2" fill="#f6e4d2" />
    <circle cx="110" cy="491" r="1.4" fill="#f6e4d2" />
  </g>

  <!-- Миша и лисёнок: фигуры из главной сцены, сдвинутые в кадр -->
  <g transform="translate(-170 -175)" filter="url(#fxSoft)">
    <ellipse cx="562" cy="644" rx="120" ry="14" fill="#a68c69" opacity="0.2" filter="url(#fxMid)" />
    <path
      d="M398 534c-5 2-8 7-8 13-1 14 0 26 2 33 8 4 20 3 26-1 2-8 2-24 0-35-3-5-10-9-20-10Z"
      fill="#a8b9a3"
    />
    <path d="M392 578c-2 7-2 14-1 20 7 3 21 3 27 0 1-6 1-13-1-20Z" fill="#bca78f" />
    <path d="M396 598l-2 32" stroke="#e8c9ad" stroke-width="8.5" stroke-linecap="round" fill="none" />
    <path d="M408 598l2 31" stroke="#e8c9ad" stroke-width="8.5" stroke-linecap="round" fill="none" />
    <ellipse cx="392" cy="634" rx="9.5" ry="4.6" fill="#7e6350" />
    <ellipse cx="412" cy="632" rx="9.5" ry="4.6" fill="#7e6350" />
    <path d="M424 542c4 3 6 8 6 14" stroke="#f2d7c0" stroke-width="6.5" stroke-linecap="round" fill="none" />
    <path d="M398 540c-9 2-16 8-20 17" stroke="#f2d7c0" stroke-width="6.5" stroke-linecap="round" fill="none" />
    <circle cx="376" cy="560" r="5.6" fill="#f2d7c0" />
    <circle cx="412" cy="514" r="19" fill="#f2d7c0" />
    <path d="M393 511c0-15 9-23 20-22 11 1 18 10 17 22-5-8-12-11-20-10-8 1-14 4-17 10Z" fill="#755640" />
    <path d="M396 505c-1 4-1 7 0 10" stroke="#755640" stroke-width="3" stroke-linecap="round" fill="none" />
    <circle cx="405" cy="515" r="1.9" fill="#4a3427" />
    <circle cx="420" cy="515" r="1.9" fill="#4a3427" />
    <path d="M408 524c3 2 6 2 9 0" stroke="#b0725c" stroke-width="2" stroke-linecap="round" fill="none" />
    <circle cx="400" cy="521" r="2.6" fill="#e3b09c" opacity="0.4" />

    <path d="M556 645c-14-26-4-52 18-58 24-6 44 10 46 36 1 14-2 22-7 28-20 8-42 6-57-6Z" fill="#c98b60" />
    <path d="M548 640c-4-28 4-50 20-58-9 20-12 40-10 58Z" fill="#f6e7d6" opacity="0.95" />
    <path
      d="M566 566c-10-15-3-30 13-34 16-4 30 6 32 20 1 13-9 23-22 25-11 2-19-1-23-11Z"
      fill="#c98b60"
    />
    <path d="M566 560c-11 0-20 4-26 11 9 6 19 6 28 3Z" fill="#c98b60" />
    <circle cx="568" cy="578" r="2.8" fill="#43332a" />
    <path d="M574 532l6-24 12 21Z" fill="#c98b60" />
    <path d="M578 530l3-13 5 11Z" fill="#e4a98b" />
    <path d="M596 530l11-17 6 20Z" fill="#c98b60" />
    <path d="M599 528l5-10 3 12Z" fill="#e4a98b" />
    <circle cx="593" cy="556" r="2.5" fill="#43332a" />
    <path d="M620 646c26-8 38-34 28-58-8 24-19 41-38 49Z" fill="#d89b70" />
    <path d="M650 590c4-11-2-19-11-22 5 13 6 18 3 26Z" fill="#f9eddd" />
    <path d="M562 648v14M588 650v12" stroke="#b0754f" stroke-width="7.5" stroke-linecap="round" />
  </g>

  <!-- светлячки -->
  <g fill="#fff4d2">
    <g class="fly" style="animation-delay:-1.4s">
      <circle cx="180" cy="286" r="11" fill="url(#fxGlow)" />
      <circle cx="180" cy="286" r="3" />
    </g>
    <g class="fly" style="animation-delay:-3.2s">
      <circle cx="392" cy="300" r="11" fill="url(#fxGlow)" />
      <circle cx="392" cy="300" r="3" />
    </g>
    <g class="fly" style="animation-delay:-5.4s">
      <circle cx="292" cy="238" r="8" fill="url(#fxGlow)" />
      <circle cx="292" cy="238" r="2.4" />
    </g>
    <g class="fly" style="animation-delay:-6.8s">
      <circle cx="470" cy="356" r="8" fill="url(#fxGlow)" />
      <circle cx="470" cy="356" r="2.4" />
    </g>
  </g>

  <rect width="560" height="560" fill="url(#fxVignette)" />
  <rect width="560" height="560" filter="url(#fxGrain)" opacity="0.08" style="mix-blend-mode:multiply" />
</svg>
