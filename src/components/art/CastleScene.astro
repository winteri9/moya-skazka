---
/**
 * Фоновая сцена финального блока: замок, звёзды, луна.
 * Рисуется без собственного фона — под ним градиент панели .finale.
 */
---

<svg
  viewBox="0 0 1440 500"
  preserveAspectRatio="xMidYMax meet"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <radialGradient id="csMoon">
      <stop offset="0" stop-color="#fdf7ea" />
      <stop offset="1" stop-color="#f5e8d6" />
    </radialGradient>
    <radialGradient id="csHalo">
      <stop offset="0" stop-color="#fdf2dc" stop-opacity="0.85" />
      <stop offset="0.55" stop-color="#fbeed9" stop-opacity="0.3" />
      <stop offset="1" stop-color="#fbeed9" stop-opacity="0" />
    </radialGradient>
    <filter id="csBlurM"><feGaussianBlur stdDeviation="9" /></filter>
    <filter id="csBlurL"><feGaussianBlur stdDeviation="22" /></filter>
    <filter id="csBlurS"><feGaussianBlur stdDeviation="3" /></filter>
  </defs>

  <!-- звёзды -->
  <g fill="#fffaf0">
    <circle cx="118" cy="66" r="2.4" opacity="0.75" />
    <circle cx="204" cy="138" r="1.8" opacity="0.6" />
    <circle cx="286" cy="52" r="2.1" opacity="0.7" />
    <circle cx="352" cy="164" r="1.6" opacity="0.5" />
    <circle cx="426" cy="86" r="2.6" opacity="0.8" />
    <circle cx="498" cy="186" r="1.7" opacity="0.45" />
    <circle cx="566" cy="62" r="2.2" opacity="0.75" />
    <circle cx="640" cy="146" r="1.8" opacity="0.55" />
    <circle cx="700" cy="58" r="2.3" opacity="0.7" />
    <circle cx="842" cy="112" r="2" opacity="0.6" />
    <circle cx="908" cy="48" r="2.5" opacity="0.8" />
    <circle cx="962" cy="168" r="1.7" opacity="0.5" />
    <circle cx="1024" cy="92" r="2.1" opacity="0.65" />
    <circle cx="1088" cy="196" r="1.6" opacity="0.42" />
    <circle cx="1246" cy="70" r="2.3" opacity="0.7" />
    <circle cx="1300" cy="150" r="1.8" opacity="0.55" />
    <circle cx="1358" cy="96" r="2.6" opacity="0.75" />
    <circle cx="160" cy="206" r="1.5" opacity="0.4" />
    <circle cx="760" cy="196" r="1.5" opacity="0.4" />
    <circle cx="1190" cy="228" r="1.6" opacity="0.38" />
  </g>
  <g fill="#fff6e4" opacity="0.85">
    <path d="M470 118l3.4 9.6 9.6 3.4-9.6 3.4L470 144l-3.4-9.6L457 131l9.6-3.4Z" />
    <path d="M880 78l2.8 8 8 2.8-8 2.8-2.8 8-2.8-8-8-2.8 8-2.8Z" opacity="0.8" />
    <path d="M1272 186l2.4 6.8 6.8 2.4-6.8 2.4-2.4 6.8-2.4-6.8-6.8-2.4 6.8-2.4Z" opacity="0.7" />
  </g>

  <!-- луна -->
  <circle cx="1150" cy="118" r="132" fill="url(#csHalo)" />
  <circle cx="1150" cy="118" r="52" fill="url(#csMoon)" />
  <g fill="#efe0cb" opacity="0.6">
    <circle cx="1134" cy="104" r="9" />
    <circle cx="1166" cy="128" r="6.5" />
    <circle cx="1140" cy="140" r="4.5" />
  </g>

  <!-- дальние холмы -->
  <path
    d="M0 336c132-32 246 6 372-6 128-12 218-42 336-30 122 12 214 46 340 34 132-12 244-30 392-18v184H0Z"
    fill="#d9c4be"
    opacity="0.55"
  />
  <path
    d="M0 372c148-26 262 12 402-2 126-12 224-38 344-26 116 12 206 44 330 32 140-14 240-26 364-14v138H0Z"
    fill="#cbb2ad"
    opacity="0.85"
  />

  <!-- замок -->
  <g transform="translate(720 372) scale(1.65) translate(-720 -372)">
    <!-- главная башня -->
    <rect x="698" y="240" width="44" height="130" fill="#c0a6a1" />
    <path d="M690 240l30-54 30 54Z" fill="#a98e8b" />
    <rect x="718" y="186" width="2.6" height="20" fill="#9c8380" />
    <path d="M720 186l16 5-16 6Z" fill="#c9ada9" />
    <rect x="712" y="258" width="16" height="20" rx="8" fill="#fbe9c8" opacity="0.9" />
    <rect x="712" y="292" width="16" height="15" rx="7" fill="#fbe9c8" opacity="0.75" />

    <!-- стена с зубцами -->
    <rect x="656" y="306" width="128" height="64" fill="#b79d99" />
    <g fill="#b79d99">
      <rect x="658" y="297" width="11" height="10" />
      <rect x="680" y="297" width="11" height="10" />
      <rect x="750" y="297" width="11" height="10" />
      <rect x="772" y="297" width="11" height="10" />
    </g>

    <!-- ворота -->
    <path d="M676 370v-18a12 12 0 0 1 24 0v18Z" fill="#9b827f" />
    <path d="M680 370v-17a8 8 0 0 1 16 0v17Z" fill="#f9dcab" opacity="0.5" />

    <!-- левая башня -->
    <rect x="628" y="284" width="36" height="86" fill="#b79d99" />
    <path d="M622 284l24-44 24 44Z" fill="#a98e8b" />
    <rect x="644" y="240" width="2.4" height="18" fill="#9c8380" />
    <path d="M646 240l14 4.5-14 5.5Z" fill="#c9ada9" />
    <rect x="639" y="302" width="11" height="15" rx="5.5" fill="#fbe9c8" opacity="0.8" />

    <!-- правая башня -->
    <rect x="776" y="290" width="34" height="80" fill="#b79d99" />
    <path d="M770 290l23-42 23 42Z" fill="#a98e8b" />
    <rect x="792" y="248" width="2.4" height="17" fill="#9c8380" />
    <path d="M794 248l13 4.5-13 5.5Z" fill="#c9ada9" />
    <rect x="787" y="306" width="11" height="15" rx="5.5" fill="#fbe9c8" opacity="0.8" />
  </g>

  <!-- ели по краям -->
  <g fill="#af9491" opacity="0.9">
    <path d="M96 372l-26-46h52Zm0-34l-30-52h60Zm0-38l-24-42h48Z" />
    <path d="M170 366l-20-36h40Zm0-26l-24-42h48Z" opacity="0.8" />
    <rect x="93" y="368" width="6" height="16" fill="#a58b88" />
    <rect x="167" y="362" width="5" height="14" fill="#a58b88" />
    <path d="M1348 372l26-46h-52Zm0-34l30-52h-60Zm0-38l24-42h-48Z" />
    <path d="M1272 366l20-36h-40Zm0-26l24-42h-48Z" opacity="0.8" />
    <rect x="1341" y="368" width="6" height="16" fill="#a58b88" />
    <rect x="1269" y="362" width="5" height="14" fill="#a58b88" />
  </g>

  <!-- туман у подножия -->
  <g fill="#f2e6d9" filter="url(#csBlurL)">
    <ellipse cx="430" cy="396" rx="240" ry="26" opacity="0.55" />
    <ellipse cx="1010" cy="404" rx="270" ry="24" opacity="0.5" />
    <ellipse cx="720" cy="382" rx="200" ry="18" opacity="0.42" />
  </g>

  <!-- передний план -->
  <path
    d="M0 442c170-18 300 10 452-2 158-12 256-30 396-18 134 12 246 26 392 16 84-6 150-10 200-6v68H0Z"
    fill="#bfa6a1"
  />
  <path d="M0 476c190-14 320 8 470-2 160-10 268 14 400 6 148-8 264 4 390-8 66-6 130-4 180 0v28H0Z" fill="#b29a97" opacity="0.85" />

  <!-- светлячки -->
  <g fill="#fdf0c2">
    <circle cx="286" cy="406" r="2.6" opacity="0.9" />
    <circle cx="372" cy="430" r="2" opacity="0.7" />
    <circle cx="1052" cy="418" r="2.4" opacity="0.85" />
    <circle cx="962" cy="440" r="1.9" opacity="0.65" />
    <circle cx="608" cy="424" r="2.2" opacity="0.8" />
    <circle cx="838" cy="436" r="1.8" opacity="0.6" />
  </g>
</svg>
